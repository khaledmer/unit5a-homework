# --- Database (Render Postgres "Internal Database URL") ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Teacher auth ---
TEACHER_PASSWORD=change_this_password
JWT_SECRET=change_this_to_a_long_random_string

# --- Email dispatch (Gmail SMTP) ---
# NOTE: Render's free web-service tier blocks outbound SMTP ports (25/465/587).
# This was confirmed on the Unit 4A portal build — "Send Corrected Results"
# will fail silently or time out on free tier. The button still works end-to-end
# for grading + PDF generation; email is best-effort only. Manual "Download PDF"
# is the reliable delivery path until the service is on a paid Render plan
# or an HTTP-API email provider (e.g. Resend, SendGrid) is swapped in.
GMAIL_USER=your_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
